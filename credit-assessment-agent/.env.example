# =============================================================================
# LLM PROVIDER — choose one of the two blocks below
# =============================================================================

# --- Option A: OpenAI (cloud) ---
LLM_PROVIDER=openai                        # Use this for OpenAI hosted models
OPENAI_API_KEY=                            # Get from https://platform.openai.com/api-keys
LLM_MODEL=gpt-4o-2024-08-06               # Model name

# --- Option B: Self-hosted / OpenAI-compatible (Ollama, vLLM, LM Studio, etc.) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama default
# LLM_BASE_URL=http://localhost:8000/v1    # vLLM default
# LLM_BASE_URL=http://localhost:1234/v1    # LM Studio default
# LLM_API_KEY=ollama                       # Ollama ignores this; vLLM may require a key
# LLM_MODEL=llama3.1:70b                   # Model name as known to your server

# Common optional settings (apply to both providers)
LLM_TEMPERATURE=0                          # 0 = deterministic output (recommended for credit)
LLM_MAX_TOKENS=1024                        # Max tokens for the final verdict response

# =============================================================================
# OPTIONAL — Langfuse observability
# Get keys from https://cloud.langfuse.com (free tier available)
# If not set, the agent runs without tracing — fully functional, just no audit log
# =============================================================================
LANGFUSE_SECRET_KEY=        # sk-lf-...
LANGFUSE_PUBLIC_KEY=        # pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# OPTIONAL — Data path
# =============================================================================
DATA_PATH=./Companies.parquet   # Path to the parquet file (default shown)

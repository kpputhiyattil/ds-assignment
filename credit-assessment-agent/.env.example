# =============================================================================
# REQUIRED
# =============================================================================
OPENAI_API_KEY=             # Get from https://platform.openai.com/api-keys

# =============================================================================
# OPTIONAL — LLM settings
# =============================================================================
OPENAI_MODEL=gpt-4o-2024-08-06   # Model to use (default shown)

# =============================================================================
# OPTIONAL — Langfuse observability
# Get keys from https://cloud.langfuse.com after signing up (free tier available)
# If not set, the agent runs without tracing (fully functional, just no audit log)
# =============================================================================
LANGFUSE_SECRET_KEY=        # sk-lf-...
LANGFUSE_PUBLIC_KEY=        # pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# OPTIONAL — Data path
# =============================================================================
DATA_PATH=./Companies.parquet   # Path to the parquet file (default shown)

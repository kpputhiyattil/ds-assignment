# ---------------------------------------------------------------------------
# LLM provider — choose one
# ---------------------------------------------------------------------------
# Option A: OpenAI hosted API
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-2024-08-06

# Option B: OpenAI-compatible (Ollama, vLLM, LM Studio, etc.)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:70b

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
DATA_PATH=./data/raw/Companies.parquet

# ---------------------------------------------------------------------------
# Batch report size (scripts/batch_assess.py when --limit is omitted)
# ---------------------------------------------------------------------------
# full  = assess every company in the dataset
# 150   = first 150 companies (after --offset)
# 50    = first 50 companies
BATCH_SIZE=150

# ---------------------------------------------------------------------------
# Langfuse (optional — agent runs without these)
# ---------------------------------------------------------------------------
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
